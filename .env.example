# ==============================================================================
# BlockOS 环境变量配置模板 (.env.example)
# 说明: 复制本文件为 .env.local 并填入你自己的密钥。
# 注意: .env.local 已加入 .gitignore，切勿将包含真实密钥的文件提交至版本库！
# ==============================================================================

# ----- 智谱大模型配置 (Zhipu AI / GLM 4.7 Flash) -----
# 申请地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
AI_MODEL=glm-4.7-flash

# ----- 硅基流动备用通道 (SiliconFlow API, 可选) -----
# 申请地址: https://siliconflow.cn/
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ----- 身份鉴权配置 (NextAuth.js) -----
# 随机生成一个 32 位以上字符串作为会话加密秘钥
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ----- 数据库连接 (Neon Serverless Postgres / SQLite, 可选) -----
# 生产环境推荐 Neon Postgres 连接串；本地若不配置则默认使用基于 sql.js 的内置存储
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
